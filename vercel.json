{
  "rewrites": [
    {
      "source": "/__l5e/:path*",
      "destination": "https://reachably.foundif.com/__l5e/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/__l5e/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
